// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "mudv-desarrollo3d-apuntes",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",
	"features": {
		"ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
			"version": "latest"
		},
		// Required to run Workbox CLI commands.
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts",
			"nodeGypDependencies": false,
			"pnpmVersion": "none",
			"nvmVersion": "none"
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// We want to used the OS provided version of Git because it includes the 'git subtree' extension.
	"postCreateCommand": "cd /usr/local/bin; for cmd in git git-* scalar; do sudo mv $cmd $cmd.bak; done",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"editor.tabSize": 2,
				// Deno extension settings
				"deno.enable": true,
				"deno.path": "/opt/quarto/bin/tools/x86_64/deno"
			},
			"extensions": [
				"denoland.vscode-deno",
				"github.vscode-github-actions",
				"pascalreitermann93.vscode-yaml-sort",
				"sumneko.lua",
				"zfscgy.bibtex-helper"
			]
		}
	},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
	"remoteUser": "vscode"
}
