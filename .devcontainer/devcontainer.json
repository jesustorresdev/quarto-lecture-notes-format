// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "mudv-desarrollo3d-apuntes",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",
	"features": {
		"ghcr.io/rocker-org/devcontainer-features/quarto-cli:latest": {
			"version": "latest"
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": ".devcontainer/postCreateCommand.sh",

	"remoteEnv": {
    "PATH": "${containerEnv:PATH}:/opt/quarto/bin/tools/x86_64",
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"editor.tabSize": 2,
				// "deno.path": "/opt/quarto/bin/tools/x86_64/deno",
				"deno.enable": true
			},
			"extensions": [
				"denoland.vscode-deno",
				"GitHub.vscode-pull-request-github",
				"github.vscode-github-actions",
				"pascalreitermann93.vscode-yaml-sort",
				"sumneko.lua",
				"zfscgy.bibtex-helper"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
